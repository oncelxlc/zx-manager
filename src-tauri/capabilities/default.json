{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-greet",
    "allow-complete-startup",
    "allow-get-system-summary",
    "allow-get-system-information",
    "clipboard-manager:allow-write-text",
    "store:allow-load",
    "store:allow-get-store",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "process:allow-restart",
    "allow-nginx-read",
    "allow-nginx-config-read",
    "allow-nginx-instance-register",
    "allow-nginx-control",
    "allow-nginx-upgrade",
    "allow-nginx-system-service"
  ]
}
