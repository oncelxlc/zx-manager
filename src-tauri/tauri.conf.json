{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zx-manager",
  "version": "0.1.0",
  "identifier": "com.oncel.zx-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZxManager",
        "width": 1600,
        "height": 900,
        "minHeight": 720,
        "minWidth": 1280,
        "visible": false,
        "focus": false,
        "backgroundColor": "#080808"
      },
      {
        "label": "splashscreen",
        "title": "ZxManager",
        "url": "/splashscreen.html",
        "width": 480,
        "height": 300,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "shadow": false,
        "backgroundColor": "#080808"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
