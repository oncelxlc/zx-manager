{
  "name": "zx-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit && node scripts/check-component-size.mjs",
    "check:component-size": "node scripts/check-component-size.mjs",
    "test": "vitest run && node --test scripts/check-component-size.node-test.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prepare": "husky install"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@reduxjs/toolkit": "^2.14.0",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
